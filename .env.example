###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=                          # generate: php -r "echo bin2hex(random_bytes(32));"
APP_NAME="Your App Name"
APP_TIMEZONE=America/Los_Angeles
###< symfony/framework-bundle ###

###> dev auth bypass ###
# Set to true to enable the /dev-login page (dev environment only).
# This has NO effect in production — APP_ENV=prod makes the route return 404 unconditionally.
APP_DEV_AUTH_ENABLED=false
###< dev auth bypass ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Create a new database on appdev-db2.mesd.k12.or.us for your app, then fill in credentials.
DATABASE_URL="postgresql://db_user:db_password@db_host:5432/your_db_name?serverVersion=11&charset=utf8"
###< doctrine/doctrine-bundle ###

###> Google OAuth ###
# Get credentials at https://console.cloud.google.com/apis/credentials
# Add http://localhost:8000/connect/google/check as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# Restrict to a specific Google Workspace domain (leave empty to allow any)
GOOGLE_HOSTED_DOMAIN=
###< Google OAuth ###
