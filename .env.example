# Local development settings. Copy to .env (gitignored) and fill in APP_SECRET:
#   cp .env.example .env
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"     # paste as APP_SECRET
# Put personal overrides in .env.local (also gitignored). Never point DATABASE_URL at
# appdev-pg-prod from a dev machine. Production settings: deploy/phantasos.env.example.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_NAME="Phantasos"
APP_TIMEZONE=America/Los_Angeles
###< symfony/framework-bundle ###

###> dev auth bypass ###
# true enables /dev-login, so you can sign in to the admin site without Google credentials.
# No effect in production: APP_ENV=prod makes the route return 404.
APP_DEV_AUTH_ENABLED=false
###< dev auth bypass ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# The local container from docker-compose-dev-db.yml (port 5448). The test suite uses its
# phantasos_dev_test database (.env.test).
DATABASE_URL="postgresql://phantasos_dev:phantasos_dev@127.0.0.1:5448/phantasos_dev?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> google oauth ###
# Only needed for real Google sign-in locally; /dev-login works without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=
###< google oauth ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> phantasos ###
MEDIA_ROOT=%kernel.project_dir%/var/media
MEDIA_ACCEL_PREFIX=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_THREADS=0
TRUSTED_PROXIES=
###< phantasos ###
