# Baked into the image as .env: NON-SECRET defaults only. Everything here can be
# overridden by the container environment, and secrets (APP_SECRET, DATABASE_URL,
# GOOGLE_CLIENT_SECRET) are supplied only that way — see deploy/phantasos.env.example.
APP_ENV=prod
APP_DEBUG=0
APP_NAME="Phantasos"
APP_TIMEZONE=America/Los_Angeles
APP_DEV_AUTH_ENABLED=false
DEFAULT_URI=https://phantasos.mesd.k12.or.us
TRUSTED_HOSTS='^(phantasos\.mesd\.k12\.or\.us|phantasos\.apps\.cascadetech\.org)$'
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MEDIA_ROOT=/media/phantasos
MEDIA_ACCEL_PREFIX=/_media
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_THREADS=0
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=
