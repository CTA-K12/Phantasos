# nginx: TLS on 443, static assets, X-Accel file delivery.
# The host's certbot deploy hook runs `podman exec phantasos-web nginx -s reload`, so keep
# ContainerName=phantasos-web.
#
# Port 80 is deliberately not published: the host firewall allows 443 only, and published
# ports can bypass firewalld. No consumer calls the API over plain HTTP (old server logs,
# 2026-10-04 to 2026-11-07). nginx still listens on 8080 inside the container; that is
# harmless and used by deploy/compose.yaml.
#
# The host adds a drop-in (10-host.conf) to all three units: RequiresMountsFor=/media,
# After=luks-unlock-media.service and REGISTRY_AUTH_FILE. Don't duplicate those here.
[Unit]
Description=Phantasos nginx
Requires=phantasos-app.service phantasos-worker.service
After=phantasos-app.service

[Container]
ContainerName=phantasos-web
Image=appdev-registry.apps.cascadetech.org/appdev-phi/phantasos-web:v1.0.2
Network=phantasos.network
PublishPort=443:8443
# Read-only: nginx only reads files PHP has authorised via X-Accel-Redirect.
Volume=/media/phantasos:/media/phantasos:ro
# fullchain.pem + privkey.pem (Let's Encrypt; the cert covers both hostnames).
Volume=/etc/phantasos/tls:/etc/nginx/tls:ro
# Optional: who may reach the management site (everything but /api/). The image's default
# is the admin-tier list in .docker/nginx/admin-access.conf; uncomment to override.
#Volume=/etc/phantasos/admin-access.conf:/etc/nginx/admin-access.conf:ro
NoNewPrivileges=true
DropCapability=ALL
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
