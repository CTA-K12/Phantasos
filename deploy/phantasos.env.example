# Runtime configuration for all three Phantasos containers.
# Install on the host as /etc/phantasos/phantasos.env, owner root:root, mode 0600.
# Never commit the real file. Non-secret defaults live in the image
# (.docker/php/env.defaults); anything set here overrides them.
#
# FORMAT: this is a Podman --env-file, not a shell file. Every character after the first '='
# is the value, so:
#   - NO quotes: they become part of the value (a quoted DATABASE_URL fails to connect).
#   - NO trailing comments: they become part of the value. Comments go on their own lines.
#   - '&', '#', '$' and spaces inside a value are fine as they are.
# Never `source` this file in a shell: the unquoted '&' in DATABASE_URL would run commands.

# New random value: openssl rand -hex 32
APP_SECRET=

# The existing phantasos role on appdev-pg-prod. Percent-encode any special characters in the password.
DATABASE_URL=postgresql://phantasos:<password>@appdev-pg-prod.apps.cascadetech.org:5432/phantasos?serverVersion=17&charset=utf8&sslmode=verify-full&sslrootcert=system&gssencmode=disable&application_name=phantasos
PGCONNECT_TIMEOUT=10

# Management-site sign-in: the production Google OAuth client. Its authorised redirect URIs:
#   https://phantasos.apps.cascadetech.org/connect/google/check
#   https://phantasos.mesd.k12.or.us/connect/google/check
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PHP-FPM workers; each holds one DB connection on appdev-pg-prod (image default 8).
FPM_MAX_CHILDREN=8
