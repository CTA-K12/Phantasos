{# Round icon button for grid action columns; tooltip via Pico's data-tooltip. #}
{% macro iconBtn(icon, label, href) %}
    <a href="{{ href }}"
       class="icon-btn"
       data-tooltip="{{ label }}"
       aria-label="{{ label }}">
        {{ _self.icon(icon) }}
    </a>
{% endmacro %}

{# Avatar: the user's Google picture, or initials from the display name. Renders nothing for null. #}
{% macro avatar(user, size = 'sm') %}
    {% if user %}
        {% if user.avatarUrl %}
            <span class="user-avatar user-avatar--{{ size }}">
                <img src="{{ user.avatarUrl }}" alt="{{ user.displayName }}" referrerpolicy="no-referrer" />
            </span>
        {% else %}
            {% set words = user.displayName|default('?')|split(' ') %}
            {% set initials = (words|first|first ~ (words|length > 1 ? words|last|first : ''))|upper %}
            <span class="user-avatar user-avatar--initials user-avatar--{{ size }}"
                  aria-label="{{ user.displayName }}" title="{{ user.displayName }}">{{ initials ?: '?' }}</span>
        {% endif %}
    {% endif %}
{% endmacro %}

{#
    Shared confirmation modal for POST actions (base.html.twig holds the single modal;
    public/js/confirm-modal.js wires it). Renders one hidden form plus a trigger.
    Params: action, token (CSRF), icon, label, title, body, confirm, variant ('' | danger |
    success | warning), reason (show optional reason field), extra (extra hidden fields).
#}
{% macro confirmAction(action, token, icon, label, title, body, confirm, variant, reason, extra) %}
    {% set uid = label|replace({' ': '-'})|lower ~ '-' ~ random(100000, 999999) %}
    <form id="cf-{{ uid }}" method="POST" action="{{ action }}" hidden>
        <input type="hidden" name="_token" value="{{ token }}">
        {% for k, v in extra|default({}) %}
            <input type="hidden" name="{{ k }}" value="{{ v }}">
        {% endfor %}
        {% if reason|default(false) %}
            <input type="hidden" name="reason" value="">
        {% endif %}
    </form>
    <a class="icon-btn{{ variant ? ' icon-btn--' ~ variant : '' }}"
       href="#"
       data-tooltip="{{ label }}"
       aria-label="{{ label }}"
       data-confirm-form="cf-{{ uid }}"
       data-confirm-title="{{ title }}"
       data-confirm-body="{{ body }}"
       data-confirm-label="{{ confirm }}"
       data-confirm-variant="{{ variant }}"
       {% if reason|default(false) %}data-confirm-reason="1"{% endif %}>
        {{ _self.icon(icon) }}
    </a>
{% endmacro %}

{# Same modal, as a full-size button for detail pages. #}
{% macro confirmActionButton(action, token, label, title, body, confirm, variant, reason, extra) %}
    {% set uid = label|replace({' ': '-'})|lower ~ '-' ~ random(100000, 999999) %}
    <form id="cf-{{ uid }}" method="POST" action="{{ action }}" hidden>
        <input type="hidden" name="_token" value="{{ token }}">
        {% for k, v in extra|default({}) %}
            <input type="hidden" name="{{ k }}" value="{{ v }}">
        {% endfor %}
        {% if reason|default(false) %}
            <input type="hidden" name="reason" value="">
        {% endif %}
    </form>
    <a role="button"
       href="#"
       class="{{ variant == 'danger' ? 'outline danger-tone' : (variant == 'warning' ? 'outline warning-tone' : '') }}"
       data-confirm-form="cf-{{ uid }}"
       data-confirm-title="{{ title }}"
       data-confirm-body="{{ body }}"
       data-confirm-label="{{ confirm }}"
       data-confirm-variant="{{ variant }}"
       {% if reason|default(false) %}data-confirm-reason="1"{% endif %}>
        {{ label }}
    </a>
{% endmacro %}
