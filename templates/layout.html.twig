{% extends 'base.html.twig' %}

{% block body %}
    <a href="#main-content" class="visually-hidden-focusable skip-link">Skip to main content</a>
    {% include '_partials/_sidebar.html.twig' %}
    <div class="main-content">
        {% include '_partials/_navbar.html.twig' %}
        <main class="main-body" id="main-content">
            {% include '_partials/_flash_messages.html.twig' %}
            {% block content %}{% endblock %}
        </main>
        <footer class="main-footer">
            © {{ "now"|date("Y") }} Cascade Technology Alliance
        </footer>
    </div>

    {# Help offcanvas — page-aware, loaded via Turbo Frame on open #}
    <div class="offcanvas offcanvas-end help-offcanvas" id="helpOffcanvas" tabindex="-1"
         aria-labelledby="helpOffcanvasLabel">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title" id="helpOffcanvasLabel">
                <i data-lucide="circle-help" style="width:18px;height:18px;vertical-align:-2px;"></i>
                Help
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <turbo-frame id="help-frame"></turbo-frame>
        </div>
    </div>

    <script>
    (function () {
        const helpOffcanvasEl = document.getElementById('helpOffcanvas');
        if (helpOffcanvasEl) {
            helpOffcanvasEl.addEventListener('show.bs.offcanvas', () => {
                const frame = document.getElementById('help-frame');
                const page  = document.getElementById('helpToggleBtn')?.dataset.helpPage ?? 'app_dashboard';
                if (!frame.getAttribute('src')) {
                    frame.setAttribute('src', '/help/' + page);
                }
            });
        }

        document.addEventListener('turbo:before-cache', () => {
            const offcanvas = document.getElementById('helpOffcanvas');
            if (offcanvas) {
                offcanvas.classList.remove('show', 'showing', 'hiding');
                document.querySelectorAll('.offcanvas-backdrop').forEach(b => b.remove());
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
                const frame = document.getElementById('help-frame');
                if (frame) frame.removeAttribute('src');
            }
        });
    }());
    </script>

{% endblock %}
