{% extends 'public.html.twig' %}

{% block title %}Dev Login — {{ app_name }}{% endblock %}

{% block body %}
<main class="container" style="max-width: 36rem; padding-top: 3rem;">
    <article style="border-left: 4px solid #f59e0b;">
        <strong>Development only.</strong> This page exists only with <code>APP_ENV=dev</code> and
        <code>APP_DEV_AUTH_ENABLED=true</code>; it signs you in as any user without Google.
    </article>
    <article>
        <header><strong>Sign in as…</strong></header>
        {% for user in users %}
            <form method="POST" action="{{ path('app_dev_login_as') }}"
                  style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
                <input type="hidden" name="email" value="{{ user.email }}">
                <span>
                    <strong>{{ user.displayName }}</strong>
                    <small style="color: var(--pico-muted-color);"> {{ user.email }} · {{ user.roles|first|replace({'ROLE_': ''})|lower }}{{ user.isActive ? '' : ' · inactive' }}</small>
                </span>
                <button type="submit" class="secondary" style="width: auto; margin: 0;">Login</button>
            </form>
        {% else %}
            <p>No users. Run <code>php bin/console doctrine:fixtures:load</code>.</p>
        {% endfor %}
    </article>
</main>
{% endblock %}
