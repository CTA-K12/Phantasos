{% extends 'base.html.twig' %}

{% block title %}Dev Login — CTA App{% endblock %}

{% block stylesheets %}
<style>
*, *::before, *::after { box-sizing: border-box; }

body { background: #f5f6f8; }

.dev-wrap {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
}

.dev-banner {
    width: 100%;
    max-width: 480px;
    background: #fef3c7;
    border: 1.5px solid #f59e0b;
    border-radius: 10px;
    padding: 0.65rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #92400e;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
}

.dev-card {
    width: 100%;
    max-width: 480px;
    background: #fff;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    overflow: hidden;
}

.dev-card-header {
    padding: 1.25rem 1.5rem 1rem;
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    align-items: center;
    gap: 0.6rem;
}

.dev-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0;
}

.dev-card-sub {
    font-size: 0.78rem;
    color: #6b7280;
    margin: 0.15rem 0 0;
}

.dev-user-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
}

.dev-user-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1.5rem;
    transition: background 0.1s;
}

.dev-user-item:hover { background: #fafafa; }

.dev-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ede9fe;
    color: #7a5af8;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.dev-user-info {
    flex: 1;
    min-width: 0;
}

.dev-user-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #111827;
    line-height: 1.3;
}

.dev-user-email {
    font-size: 0.75rem;
    color: #6b7280;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dev-badges {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
}

.dev-login-btn {
    flex-shrink: 0;
    border: none;
    background: #7a5af8;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 7px;
    cursor: pointer;
    transition: background 0.15s;
}

.dev-login-btn:hover { background: #6d28d9; }

.dev-card-footer {
    padding: 0.75rem 1.5rem;
    border-top: 1px solid #f3f4f6;
    font-size: 0.72rem;
    color: #9ca3af;
    text-align: center;
}
</style>
{% endblock %}

{% block body %}
<div class="dev-wrap">

    <div class="dev-banner">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        DEV ENVIRONMENT — This page does not exist in production
    </div>

    <div class="dev-card">
        <div class="dev-card-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="#7a5af8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <div>
                <p class="dev-card-title">Log in as…</p>
                <p class="dev-card-sub">Choose any fixture user — no Google auth required</p>
            </div>
        </div>

        <ul class="dev-user-list">
            {% for user in users %}
            <li class="dev-user-item">
                <div class="dev-avatar">
                    {{ user.displayName|slice(0,1)|upper }}{{ user.displayName|split(' ')|last|slice(0,1)|upper }}
                </div>
                <div class="dev-user-info">
                    <div class="dev-user-name">{{ user.displayName }}</div>
                    <div class="dev-user-email">{{ user.email }}</div>
                    <div class="dev-badges">
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="badge badge-soft-purple" style="font-size:0.68rem;">Admin</span>
                        {% elseif 'ROLE_SUPERVISOR' in user.roles %}
                            <span class="badge badge-soft-info" style="font-size:0.68rem;">Supervisor</span>
                        {% else %}
                            <span class="badge badge-soft-secondary" style="font-size:0.68rem;">Staff</span>
                        {% endif %}
                        {% if not user.isActive %}
                            <span class="badge badge-soft-warning" style="font-size:0.68rem;">Inactive</span>
                        {% endif %}
                    </div>
                </div>
                <form method="POST" action="{{ path('app_dev_login_as') }}">
                    <input type="hidden" name="email" value="{{ user.email }}">
                    <button type="submit" class="dev-login-btn">Login</button>
                </form>
            </li>
            {% endfor %}
        </ul>

        <div class="dev-card-footer">
            Bypass enabled via <code>APP_DEV_AUTH_ENABLED=true</code> in <code>.env.local</code>
        </div>
    </div>

</div>
{% endblock %}
