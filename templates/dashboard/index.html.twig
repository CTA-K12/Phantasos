{% extends 'base.html.twig' %}

{% block title %}Dashboard — {{ app_name }}{% endblock %}
{% block breadcrumbs %}<li>Dashboard</li>{% endblock %}

{% block body %}
<div class="stat-row">
    <article><span class="stat-value">{{ activeClients }}</span><span class="stat-label">active clients</span></article>
    <article><span class="stat-value">{{ totalMedia|number_format }}</span><span class="stat-label">media stored</span></article>
    <article><span class="stat-value">{{ uploadsWeek|number_format }}</span><span class="stat-label">uploads, last 7 days</span></article>
    <article><span class="stat-value">{{ servedWeek|number_format }}</span><span class="stat-label">files served, last 7 days</span></article>
    <article><span class="stat-value">{{ queue.waiting + queue.running }}</span><span class="stat-label">in processing queue</span></article>
    <article>
        <span class="stat-value">
            {% if problems > 0 and is_granted('ROLE_ADMIN') %}<a href="{{ path('admin_processing_index') }}">{{ problems }}</a>{% else %}{{ problems }}{% endif %}
        </span>
        <span class="stat-label">failed or stuck</span>
    </article>
</div>

<article>
    <header><strong>Recent uploads</strong></header>
    {{ include('admin/_media_table.html.twig', {media: recent, show_client: true}) }}
</article>
{% endblock %}
