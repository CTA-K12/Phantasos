{% extends 'layout.html.twig' %}

{% block title %}Dashboard - CTA App{% endblock %}

{% block content %}
<div class="row align-items-center mb-4 g-3">
    <div class="col-12 col-md">
        <h4 class="mb-0">Dashboard</h4>
    </div>
</div>

{#
    Chart cards grid.
    The chart_controller.js supports the following chart types via data-chart-type-value:
      - "donut"  — expects [{label, count, color}]
      - "line"   — expects [{date, count}]
      - "bar"    — expects stacked series or [{label/name, count}]

    The data URL endpoint (app_dashboard_data) must return a JSON object.
    Use data-chart-chart-key-value to specify which key in the JSON response to use.

    Add additional chart cards here — see chart_controller.js for supported types.
#}
<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Activity by Type</div>
            <div class="card-body">
                <div class="chart-container"
                     data-controller="chart"
                     data-chart-type-value="donut"
                     data-chart-data-url-value="{{ path('app_dashboard_data') }}"
                     data-chart-chart-key-value="activityByType">
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Activity by User</div>
            <div class="card-body">
                <div class="chart-container"
                     data-controller="chart"
                     data-chart-type-value="hbar"
                     data-chart-data-url-value="{{ path('app_dashboard_data') }}"
                     data-chart-chart-key-value="activityByUser"
                     data-chart-row-hover-value="true">
                </div>
            </div>
        </div>
    </div>
    {# Add additional chart cards here #}
</div>
{% endblock %}
