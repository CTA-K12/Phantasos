{# Shared fields — included by new.html.twig and edit.html.twig #}
{{ form_row(form.displayName) }}
{{ form_row(form.email, {help: "Must match the user's Google Workspace account email."}) }}
{{ form_row(form.role) }}
<label>
    {{ form_widget(form.isActive, {attr: {role: 'switch'}}) }}
    Active
</label>
<small class="muted">Inactive users cannot sign in and land on the pending-approval page.</small>
{{ form_errors(form.isActive) }}
