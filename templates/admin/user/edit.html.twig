{% extends 'base.html.twig' %}

{% block title %}Edit {{ user.displayName }} — {{ app_name }}{% endblock %}
{% block breadcrumbs %}
    <li><a href="{{ path('admin_user_index') }}">Users</a></li>
    <li>{{ user.displayName }}</li>
{% endblock %}

{% block body %}
<article style="max-width: 40rem;">
    <header><strong>Edit {{ user.displayName }}</strong></header>
    {{ form_start(form) }}
        {% include 'admin/user/_form.html.twig' %}
        {{ form_rest(form) }}
        <div style="display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1rem;">
            <a role="button" class="secondary outline" href="{{ path('admin_user_index') }}">Cancel</a>
            <button type="submit" style="width: auto;">Save</button>
        </div>
    {{ form_end(form) }}
</article>
{% endblock %}
