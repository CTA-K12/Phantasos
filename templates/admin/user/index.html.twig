{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block title %}Users — {{ app_name }}{% endblock %}
{% block breadcrumbs %}<li>Users</li>{% endblock %}
{% block breadcrumb_actions %}
    <a role="button" href="{{ path('admin_user_new') }}" class="breadcrumb-action-btn">{{ macros.icon('plus') }} New User</a>
{% endblock %}

{% block body %}
<article>
    <p class="muted">People who can sign in to this management site with Google. API clients are under
        <a href="{{ path('admin_client_index') }}">Clients &amp; Keys</a>.</p>
    <figure>
        <table role="grid">
            <thead>
                <tr><th>Actions</th><th>User</th><th>Role</th><th>Status</th><th>Last sign-in</th></tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>
                            <div class="icon-btn-group">
                                {{ macros.iconBtn('edit', 'Edit', path('admin_user_edit', {id: user.id})) }}
                                {% if user.isActive %}
                                    {{ macros.confirmAction(path('admin_user_toggle', {id: user.id}), csrf_token('toggle-user-' ~ user.id),
                                        'x', 'Deactivate', 'Deactivate ' ~ user.displayName ~ '?',
                                        'They will not be able to sign in until reactivated.', 'Deactivate', 'danger') }}
                                {% else %}
                                    {{ macros.confirmAction(path('admin_user_toggle', {id: user.id}), csrf_token('toggle-user-' ~ user.id),
                                        'check', 'Activate', 'Activate ' ~ user.displayName ~ '?',
                                        'They will be able to sign in.', 'Activate', 'success') }}
                                {% endif %}
                            </div>
                        </td>
                        <td>
                            <div style="display: flex; gap: 0.6rem; align-items: center;">
                                {{ macros.avatar(user, 'md') }}
                                <div><strong>{{ user.displayName }}</strong><br><small class="muted">{{ user.email }}</small></div>
                            </div>
                        </td>
                        <td>
                            {% if 'ROLE_ADMIN' in user.roles %}Admin{% elseif 'ROLE_SUPERVISOR' in user.roles %}Supervisor{% else %}Staff{% endif %}
                        </td>
                        <td>{% if user.isActive %}<span class="pill pill--ok">Active</span>{% else %}<span class="pill pill--warn">Inactive</span>{% endif %}</td>
                        <td>{{ user.lastLoginAt ? user.lastLoginAt|date('M j, Y') : '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5"><em>No users found.</em></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </figure>
</article>
{% endblock %}
