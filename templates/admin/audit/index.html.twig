{% extends 'layout.html.twig' %}

{% block title %}Audit Log — Admin{% endblock %}

{% block content %}

{# ── Page header ── #}
<div class="row align-items-center mb-3 g-3">
    <div class="col-12 col-md">
        <h4 class="mb-0">Audit Log &amp; Data Retention</h4>
    </div>
    <div class="col-12 col-md-auto">
        <div class="bg-white border rounded px-3 py-2">
            <div class="row g-2">
                <div class="col-12 col-md-auto">
                    <a href="{{ path('admin_audit_export', filters) }}"
                       class="btn btn-outline-secondary btn-sm w-100">
                        <i data-lucide="download" style="width:15px;height:15px;vertical-align:-2px;"></i> Export CSV
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── Tab navigation ── #}
<ul class="nav nav-tabs mb-0" id="auditTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link {{ activeTab != 'log' ? 'active' }}"
           href="{{ path('admin_audit_index', {tab: 'retention'}) }}"
           role="tab">
            <i data-lucide="shield-alert" style="width:15px;height:15px;vertical-align:-2px;"></i>
            Data Retention
            {% if eligibleCount > 0 %}
                <span class="badge badge-soft-warning ms-1">{{ eligibleCount }}</span>
            {% endif %}
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link {{ activeTab == 'log' ? 'active' }}"
           href="{{ path('admin_audit_index', {tab: 'log'}) }}"
           role="tab">
            <i data-lucide="shield-check" style="width:15px;height:15px;vertical-align:-2px;"></i>
            Audit Log
            {% if total > 0 %}
                <span class="badge badge-soft-secondary ms-1">{{ total }}</span>
            {% endif %}
        </a>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom">

{# ══════════════════════════════════════════════════════════════ #}
{# Tab: Data Retention                                            #}
{# ══════════════════════════════════════════════════════════════ #}
<div id="retention-panel"
     class="tab-pane fade {{ activeTab != 'log' ? 'show active' }}"
     role="tabpanel">
    <div class="p-4">

        <div class="alert alert-warning mb-4">
            <i data-lucide="alert-triangle" style="width:15px;height:15px;vertical-align:-2px;"></i>
            <strong>Notice:</strong> Review your organization's data retention policies before purging records.
            Purging is permanent and cannot be undone.
        </div>

        {# Retention period form #}
        <form method="POST" action="{{ path('admin_audit_retention') }}"
              class="row g-2 align-items-end mb-4">
            <input type="hidden" name="_token" value="{{ csrf_token('audit-retention') }}">
            <div class="col-auto">
                <label for="retention_months" class="form-label mb-1 small fw-semibold">Retention Period</label>
                <div class="input-group input-group-sm">
                    <input type="number" id="retention_months" name="retention_months"
                           class="form-control" style="width:80px;"
                           value="{{ retentionMonths }}" min="1" max="120">
                    <span class="input-group-text">months</span>
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i data-lucide="save" style="width:14px;height:14px;vertical-align:-2px;"></i> Save
                </button>
            </div>
            <div class="col-auto">
                <span class="text-muted small">
                    Cutoff date: <strong>{{ cutoff|date('M j, Y') }}</strong>
                </span>
            </div>
        </form>

        {# Eligible records summary #}
        {% if eligibleCount == 0 %}
            <div class="text-center text-muted py-5">
                <i data-lucide="check-circle" style="width:40px;height:40px;opacity:.25;display:block;margin:0 auto 12px;"></i>
                <p class="mb-0">No audit log entries are older than the {{ retentionMonths }}-month retention period.</p>
            </div>
        {% else %}
            <div class="card">
                <div class="card-body d-flex align-items-center gap-4">
                    <div>
                        <div class="fw-semibold fs-5">{{ eligibleCount }} audit log {{ eligibleCount == 1 ? 'entry' : 'entries' }}</div>
                        <div class="text-muted small">
                            Recorded before {{ cutoff|date('M j, Y') }} — older than {{ retentionMonths }} months
                        </div>
                    </div>
                    <form method="POST" action="{{ path('admin_audit_purge') }}"
                          class="ms-auto"
                          onsubmit="return confirm('Permanently delete {{ eligibleCount }} audit log {{ eligibleCount == 1 ? 'entry' : 'entries' }} older than {{ cutoff|date('M j, Y') }}? This cannot be undone.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('audit-purge') }}">
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i data-lucide="trash-2" style="width:14px;height:14px;vertical-align:-2px;"></i>
                            Purge {{ eligibleCount }} {{ eligibleCount == 1 ? 'Entry' : 'Entries' }}
                        </button>
                    </form>
                </div>
            </div>
        {% endif %}

    </div>
</div>

{# ══════════════════════════════════════════════════════════════ #}
{# Tab: Audit Log                                                 #}
{# ══════════════════════════════════════════════════════════════ #}
<div id="log-panel"
     class="tab-pane fade {{ activeTab == 'log' ? 'show active' }}"
     role="tabpanel">

    {# Filter bar #}
    <div class="p-3 border-bottom">
        <form method="GET" action="{{ path('admin_audit_index') }}" class="row g-2 align-items-end">
            <input type="hidden" name="tab" value="log">
            <div class="col-sm-auto">
                <label class="form-label small mb-1">From</label>
                <input type="date" name="from" class="form-control form-control-sm" value="{{ filters.from }}">
            </div>
            <div class="col-sm-auto">
                <label class="form-label small mb-1">To</label>
                <input type="date" name="to" class="form-control form-control-sm" value="{{ filters.to }}">
            </div>
            <div class="col-sm-auto">
                <label class="form-label small mb-1">User</label>
                <select name="userId" class="form-select form-select-sm" style="min-width:180px;">
                    <option value="">All users</option>
                    {% for user in users %}
                        <option value="{{ user.id }}" {{ filters.userId == (user.id ~ '') ? 'selected' }}>
                            {{ user.displayName }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-auto">
                <label class="form-label small mb-1">Action</label>
                <select name="action" class="form-select form-select-sm" style="min-width:200px;">
                    <option value="">All actions</option>
                    {% for actionKey in actions %}
                        <option value="{{ actionKey }}" {{ filters.action == actionKey ? 'selected' }}>
                            {{ actionLabels[actionKey] ?? actionKey }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-sm-auto d-flex align-items-end gap-1">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i data-lucide="filter" style="width:14px;height:14px;vertical-align:-2px;"></i> Filter
                </button>
                <a href="{{ path('admin_audit_index', {tab: 'log'}) }}" class="btn btn-outline-secondary btn-sm">
                    <i data-lucide="x" style="width:14px;height:14px;vertical-align:-2px;"></i> Clear
                </a>
            </div>
        </form>
    </div>

    {# Log table #}
    <div class="table-responsive">
        <table class="table table-hover table-sm mb-0">
            <thead>
                <tr>
                    <th style="min-width:145px;">When</th>
                    <th>Who</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Details</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logs %}
                <tr>
                    <td class="text-muted small text-nowrap">
                        {{ log.createdAt|date('M j, Y g:i A') }}
                    </td>
                    <td class="small">
                        {% if log.user %}
                            <div class="fw-semibold lh-sm">{{ log.user.displayName }}</div>
                            <div class="text-muted" style="font-size:.75rem;">{{ log.user.email }}</div>
                        {% else %}
                            <span class="text-muted fst-italic">(system)</span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge badge-soft-purple">
                            {{ actionLabels[log.action] ?? log.action }}
                        </span>
                    </td>
                    <td class="text-muted small">
                        {% if log.entityType %}
                            <div>{{ log.entityType }}</div>
                            {% if log.entityId %}
                                <div style="font-size:.7rem;font-family:monospace;">{{ log.entityId|slice(0,8) }}…</div>
                            {% endif %}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="small text-muted">
                        {% for key, val in log.metadata %}
                            <span class="me-2">
                                <span class="fw-semibold">{{ key }}:</span>
                                {{ val is iterable ? val|join(', ') : val }}
                            </span>
                        {% else %}
                            —
                        {% endfor %}
                    </td>
                    <td class="text-muted small text-nowrap">
                        {{ log.ipAddress ?? '—' }}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No audit log entries found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
        <span class="text-muted small">
            {% if total == 0 %}
                No records found
            {% else %}
                Showing {{ ((page - 1) * limit) + 1 }}–{{ min(page * limit, total) }} of {{ total }} record{{ total != 1 ? 's' }}
            {% endif %}
        </span>
        {% if totalPages > 1 %}
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item {{ page <= 1 ? 'disabled' }}">
                    <a class="page-link" href="{{ path('admin_audit_index', filters|merge({p: page - 1})) }}">‹</a>
                </li>
                {% for p in range(max(1, page - 2), min(totalPages, page + 2)) %}
                    <li class="page-item {{ p == page ? 'active' }}">
                        <a class="page-link" href="{{ path('admin_audit_index', filters|merge({p: p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}
                <li class="page-item {{ page >= totalPages ? 'disabled' }}">
                    <a class="page-link" href="{{ path('admin_audit_index', filters|merge({p: page + 1})) }}">›</a>
                </li>
            </ul>
        </nav>
        {% endif %}
    </div>

</div>
</div>{# /tab-content #}

{% endblock %}
