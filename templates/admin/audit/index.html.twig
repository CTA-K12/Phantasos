{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as macros %}

{% block title %}Audit Log — {{ app_name }}{% endblock %}
{% block breadcrumbs %}<li>Audit Log</li>{% endblock %}
{% block breadcrumb_actions %}
    <a role="button" class="breadcrumb-action-btn secondary" href="{{ path('admin_audit_export', filters) }}">{{ macros.icon('download') }} Export CSV</a>
{% endblock %}

{% block body %}
<nav class="page-tabs" aria-label="Audit sections">
    <a href="{{ path('admin_audit_index', {tab: 'log'}) }}" class="page-tab{{ activeTab == 'log' ? ' page-tab--active' }}">
        Audit Log{% if total > 0 %} <small>({{ total|number_format }})</small>{% endif %}
    </a>
    <a href="{{ path('admin_audit_index', {tab: 'retention'}) }}" class="page-tab{{ activeTab == 'retention' ? ' page-tab--active' }}">
        Data Retention{% if eligibleCount > 0 %} <small>({{ eligibleCount|number_format }})</small>{% endif %}
    </a>
</nav>

{% if activeTab == 'retention' %}
<article>
    <p><strong>Purging is permanent.</strong> Check the retention policy before deleting records.</p>
    <form method="POST" action="{{ path('admin_audit_retention') }}" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
        <input type="hidden" name="_token" value="{{ csrf_token('audit-retention') }}">
        <label style="margin: 0;">Retention period (months)
            <input type="number" name="retention_months" value="{{ retentionMonths }}" min="1" max="120" style="width: 8rem; margin: 0;">
        </label>
        <button type="submit" style="width: auto; margin: 0;">Save</button>
        <span class="muted">Cutoff: <strong>{{ cutoff|date('M j, Y') }}</strong></span>
    </form>
    <hr>
    {% if eligibleCount == 0 %}
        <p class="muted">No entries are older than the {{ retentionMonths }}-month retention period.</p>
    {% else %}
        <p>{{ eligibleCount|number_format }} {{ eligibleCount == 1 ? 'entry was' : 'entries were' }} recorded before {{ cutoff|date('M j, Y') }}.</p>
        {{ macros.confirmActionButton(path('admin_audit_purge'), csrf_token('audit-purge'),
            'Purge ' ~ eligibleCount ~ (eligibleCount == 1 ? ' entry' : ' entries'),
            'Permanently delete ' ~ eligibleCount ~ ' audit log entries?',
            'Entries recorded before ' ~ cutoff|date('M j, Y') ~ ' are deleted. This cannot be undone.',
            'Purge', 'danger') }}
    {% endif %}
</article>
{% else %}
<article>
    <form method="GET" action="{{ path('admin_audit_index') }}" style="display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap;">
        <input type="hidden" name="tab" value="log">
        <label style="margin: 0;">From <input type="date" name="from" value="{{ filters.from }}" style="margin: 0;"></label>
        <label style="margin: 0;">To <input type="date" name="to" value="{{ filters.to }}" style="margin: 0;"></label>
        <label style="margin: 0;">User
            <select name="userId" style="margin: 0;">
                <option value="">All users</option>
                {% for user in users %}
                    <option value="{{ user.id }}" {{ filters.userId == (user.id ~ '') ? 'selected' }}>{{ user.displayName }}</option>
                {% endfor %}
            </select>
        </label>
        <label style="margin: 0;">Action
            <select name="action" style="margin: 0;">
                <option value="">All actions</option>
                {% for actionKey in actions %}
                    <option value="{{ actionKey }}" {{ filters.action == actionKey ? 'selected' }}>{{ actionLabels[actionKey] ?? actionKey }}</option>
                {% endfor %}
            </select>
        </label>
        <button type="submit" style="width: auto; margin: 0;">Filter</button>
        <a role="button" class="secondary outline" href="{{ path('admin_audit_index', {tab: 'log'}) }}" style="margin: 0;">Clear</a>
    </form>

    <figure>
        <table role="grid">
            <thead>
                <tr><th>When</th><th>Who</th><th>Action</th><th>Entity</th><th>Details</th><th>IP</th></tr>
            </thead>
            <tbody>
                {% for log in logs %}
                    <tr>
                        <td style="white-space: nowrap;">{{ log.createdAt|date('M j, Y g:i A') }}</td>
                        <td>
                            {% if log.user %}
                                <strong>{{ log.user.displayName }}</strong><br><small class="muted">{{ log.user.email }}</small>
                            {% elseif log.metadata.client is defined %}
                                API: <strong>{{ log.metadata.client }}</strong>
                            {% else %}
                                <em class="muted">(system)</em>
                            {% endif %}
                        </td>
                        <td>{{ actionLabels[log.action] ?? log.action }}</td>
                        <td>
                            {% if log.entityType %}{{ log.entityType }}<br><small class="mono">{{ log.entityId }}</small>{% else %}—{% endif %}
                        </td>
                        <td>
                            {% for key, val in log.metadata %}
                                <small><strong>{{ key }}:</strong> {{ val is iterable ? val|join(', ') : val }}</small>{% if not loop.last %}<br>{% endif %}
                            {% else %}—{% endfor %}
                        </td>
                        <td>{{ log.ipAddress ?? '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6"><em>No audit log entries found.</em></td></tr>
                {% endfor %}
            </tbody>
        </table>
    </figure>

    <div style="display: flex; justify-content: space-between; align-items: center;">
        <small class="muted">
            {% if total == 0 %}No records{% else %}Showing {{ ((page - 1) * limit) + 1 }}–{{ min(page * limit, total) }} of {{ total|number_format }}{% endif %}
        </small>
        {% if totalPages > 1 %}
            <div style="display: flex; gap: 0.25rem;">
                {% if page > 1 %}<a role="button" class="secondary outline" href="{{ path('admin_audit_index', filters|merge({p: page - 1})) }}">‹</a>{% endif %}
                {% for p in range(max(1, page - 2), min(totalPages, page + 2)) %}
                    <a role="button" class="{{ p == page ? '' : 'secondary outline' }}" href="{{ path('admin_audit_index', filters|merge({p: p})) }}">{{ p }}</a>
                {% endfor %}
                {% if page < totalPages %}<a role="button" class="secondary outline" href="{{ path('admin_audit_index', filters|merge({p: page + 1})) }}">›</a>{% endif %}
            </div>
        {% endif %}
    </div>
</article>
{% endif %}
{% endblock %}
