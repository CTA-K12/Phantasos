{% extends 'layout.html.twig' %}

{% block title %}Support - CTA App{% endblock %}

{% block content %}
<h4 class="mb-4">Support</h4>

<div class="row g-4">

    {# Get Help card #}
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="d-flex align-items-center gap-2 mb-2">
                    <i data-lucide="life-buoy" style="width:18px;height:18px;color:#7a5af8;"></i>
                    Get Help
                </h6>
                <p class="text-muted small mb-4">Need help? Our team is here to assist. Choose an option below to get started.</p>

                <a href="https://cascadetech.freshservice.com" target="_blank" rel="noopener"
                   class="d-flex align-items-center justify-content-between text-decoration-none border rounded p-3 mb-3 support-action-row">
                    <div class="d-flex align-items-center gap-3">
                        <span class="support-action-icon">
                            <i data-lucide="external-link" style="width:18px;height:18px;color:#7a5af8;"></i>
                        </span>
                        <div>
                            <div class="fw-semibold text-dark">Submit a Ticket</div>
                            <div class="text-muted small">Open the FreshService portal to create or track a support request.</div>
                        </div>
                    </div>
                    <i data-lucide="chevron-right" style="width:18px;height:18px;color:#adb5bd;flex-shrink:0;"></i>
                </a>

                <a href="mailto:appdevsupport@cascadetech.org"
                   class="d-flex align-items-center justify-content-between text-decoration-none border rounded p-3 support-action-row">
                    <div class="d-flex align-items-center gap-3">
                        <span class="support-action-icon">
                            <i data-lucide="mail" style="width:18px;height:18px;color:#7a5af8;"></i>
                        </span>
                        <div>
                            <div class="fw-semibold text-dark">Email Support</div>
                            <div class="text-muted small">Send an email to appdevsupport@cascadetech.org</div>
                        </div>
                    </div>
                    <i data-lucide="chevron-right" style="width:18px;height:18px;color:#adb5bd;flex-shrink:0;"></i>
                </a>
            </div>
        </div>
    </div>

    {# Quick Info card #}
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="d-flex align-items-center gap-2 mb-2">
                    <i data-lucide="info" style="width:18px;height:18px;color:#7a5af8;"></i>
                    Quick Info
                </h6>
                <p class="text-muted small mb-4">Include this information when submitting a support request to help us assist you faster.</p>

                <table class="table table-borderless mb-0 settings-table">
                    <tbody>
                        <tr>
                            <td class="text-muted ps-0">Name</td>
                            <td class="text-end pe-0">{{ app.user.displayName }}</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Email</td>
                            <td class="text-end pe-0">{{ app.user.email }}</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Role</td>
                            <td class="text-end pe-0">{{ roleLabel }}</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Environment</td>
                            <td class="text-end pe-0">{{ appEnv }}</td>
                        </tr>
                        <tr class="border-bottom-0">
                            <td class="text-muted ps-0 border-bottom-0">Database</td>
                            <td class="text-end pe-0 border-bottom-0">{{ dbName }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
