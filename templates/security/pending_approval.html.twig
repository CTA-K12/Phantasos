{% extends 'public.html.twig' %}

{% block title %}Pending Approval — {{ app_name }}{% endblock %}

{% block body %}
<main class="container" style="max-width: 32rem; padding-top: 6rem; text-align: center;">
    <article>
        <h3>Account pending approval</h3>
        <p>Your account exists, but an administrator needs to activate it before you can use {{ app_name }}.</p>
        <p><small>Contact the CTA application team to request access.</small></p>
        <form method="POST" action="{{ path('app_logout') }}">
            <button type="submit" class="secondary" style="width: auto;">Sign out</button>
        </form>
    </article>
</main>
{% endblock %}
