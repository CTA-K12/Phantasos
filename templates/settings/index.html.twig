{% extends 'layout.html.twig' %}

{% block title %}Settings - CTA App{% endblock %}

{% block content %}
<h4 class="mb-4">Settings</h4>

<div class="row g-4">

    {# Profile card #}
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="d-flex align-items-center gap-2 mb-4">
                    <i data-lucide="user" style="width:18px;height:18px;color:#7a5af8;"></i>
                    Profile
                </h6>

                <div class="d-flex align-items-center gap-3 mb-4">
                    {% if app.user.avatarUrl %}
                        <img src="{{ app.user.avatarUrl }}" alt="" class="user-avatar" style="width:52px;height:52px;">
                    {% else %}
                        <span class="avatar-initials" style="width:52px;height:52px;font-size:1.1rem;background-color:{{ avatar_color(app.user.displayName) }};">
                            {{ initials(app.user.displayName) }}
                        </span>
                    {% endif %}
                    <div>
                        <div class="fw-semibold fs-6">{{ app.user.displayName }}</div>
                        <span class="badge badge-soft-purple mt-1">{{ roleLabel }}</span>
                    </div>
                </div>

                <table class="table table-borderless mb-0 settings-table">
                    <tbody>
                        <tr>
                            <td class="text-muted ps-0">Name</td>
                            <td class="text-end pe-0">{{ app.user.displayName }}</td>
                        </tr>
                        <tr>
                            <td class="text-muted ps-0">Email</td>
                            <td class="text-end pe-0">{{ app.user.email }}</td>
                        </tr>
                        <tr class="border-bottom-0">
                            <td class="text-muted ps-0 border-bottom-0">Role</td>
                            <td class="text-end pe-0 border-bottom-0">{{ roleLabel }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# System card #}
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="d-flex align-items-center gap-2 mb-4">
                    <i data-lucide="server" style="width:18px;height:18px;color:#7a5af8;"></i>
                    System
                </h6>

                <table class="table table-borderless mb-0 settings-table">
                    <tbody>
                        <tr>
                            <td class="text-muted ps-0">Application Environment</td>
                            <td class="text-end pe-0">{{ appEnv }}</td>
                        </tr>
                        <tr class="border-bottom-0">
                            <td class="text-muted ps-0 border-bottom-0">Database</td>
                            <td class="text-end pe-0 border-bottom-0">{{ dbName }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {#
        Add app-specific preference cards here.
        Example structure:
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="d-flex align-items-center gap-2 mb-4">
                        <i data-lucide="sliders-horizontal" style="width:18px;height:18px;color:#7a5af8;"></i>
                        Preferences
                    </h6>
                    <form method="post" action="{{ path('app_settings_preferences') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('settings-preferences') }}">
                        ...
                    </form>
                </div>
            </div>
        </div>
    #}

</div>
{% endblock %}
