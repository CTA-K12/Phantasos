<header class="main-header no-print">
    <div class="d-flex align-items-center">
        <button class="btn btn-link d-lg-none me-2 p-0" type="button"
                onclick="document.getElementById('sidebar').classList.toggle('show')"
                aria-label="Toggle navigation">
            <i data-lucide="menu" style="width:24px;height:24px;"></i>
        </button>
        <h5 class="mb-0 text-muted">{% block page_title %}{% endblock %}</h5>
    </div>

    <div class="d-flex align-items-center gap-3">
        <button type="button"
                class="btn-icon"
                id="helpToggleBtn"
                data-bs-toggle="offcanvas"
                data-bs-target="#helpOffcanvas"
                data-help-page="{{ app.request.attributes.get('_route') }}"
                title="Help">
            <i data-lucide="circle-help" style="width:20px;height:20px;"></i>
        </button>
    </div>
</header>
