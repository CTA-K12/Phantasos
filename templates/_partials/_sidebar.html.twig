{% set _route = app.request.attributes.get('_route') %}
{% set _isAdmin = _route starts with 'admin_' %}

<nav class="sidebar" id="sidebar" aria-label="Main navigation">
    <div class="sidebar-brand">
        <i data-lucide="layers" style="width:22px;height:22px;"></i> CTA App
    </div>

    <ul class="nav flex-column mt-2 sidebar-nav">
        <li class="nav-item">
            <a class="nav-link {{ _route starts with 'app_dashboard' ? 'active' }}"
               href="{{ path('app_dashboard') }}">
                <i data-lucide="layout-dashboard"></i> Dashboard
            </a>
        </li>
        {# Add main nav links here #}

        {# ── Admin group ───────────────────────────────────────────────────── #}
        {% if is_granted('ROLE_ADMIN') %}
        <li class="sidebar-group">
            <button class="sidebar-group-toggle" type="button"
                    data-bs-toggle="collapse" data-bs-target="#sidebarGroupAdmin"
                    aria-expanded="{{ _isAdmin ? 'true' : 'false' }}"
                    aria-controls="sidebarGroupAdmin">
                <span>Admin</span>
                <i data-lucide="chevron-down" class="sidebar-group-chevron"></i>
            </button>
            <ul class="nav flex-column collapse {{ _isAdmin ? 'show' }}" id="sidebarGroupAdmin">
                <li class="nav-item">
                    <a class="nav-link {{ _route starts with 'admin_user' ? 'active' }}"
                       href="{{ path('admin_user_index') }}">
                        <i data-lucide="user-cog"></i> Users
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ _route starts with 'admin_audit' ? 'active' }}"
                       href="{{ path('admin_audit_index') }}">
                        <i data-lucide="shield-check"></i> Audit Log
                    </a>
                </li>
                {# Add admin nav links here #}
            </ul>
        </li>
        {% endif %}
    </ul>

    <div class="sidebar-footer">
        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_support' ? 'active' }}"
           href="{{ path('app_support') }}">
            <i data-lucide="life-buoy"></i> Support
        </a>
        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_settings' ? 'active' }}"
           href="{{ path('app_settings') }}">
            <i data-lucide="settings"></i> Settings
        </a>

        <hr class="sidebar-footer-divider">

        {% if app.user %}
        <div class="sidebar-user">
            <div class="sidebar-user-info">
                {% if app.user.avatarUrl %}
                    <img src="{{ app.user.avatarUrl }}" alt="" class="user-avatar">
                {% else %}
                    <span class="avatar-initials avatar-initials-sm" style="background-color: {{ avatar_color(app.user.displayName) }}; flex-shrink:0;">
                        {{ initials(app.user.displayName) }}
                    </span>
                {% endif %}
                <div class="sidebar-user-text">
                    <div class="sidebar-user-name">{{ app.user.displayName }}</div>
                    <div class="sidebar-user-email">{{ app.user.email }}</div>
                </div>
            </div>
            <a href="{{ path('app_logout') }}" class="sidebar-logout" title="Sign out">
                <i data-lucide="log-out" style="width:16px;height:16px;"></i>
            </a>
        </div>
        {% endif %}
    </div>
</nav>
